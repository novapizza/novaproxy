{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NovaProxy",
  "version": "0.3.0",
  "identifier": "dev.novaproxy.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build && cargo build --release -p nova-helper"
  },
  "app": {
    "windows": [
      {
        "title": "NovaProxy",
        "maximized": true,
        "width": 1320,
        "height": 860,
        "minWidth": 940,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
